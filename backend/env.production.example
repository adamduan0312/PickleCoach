# Production environment template — copy to `.env.production` on the host.
# Never commit real secrets. All values below are placeholders.

NODE_ENV=production
PORT=4000

# Comma-separated browser origins (required). No wildcard.
FRONTEND_URL=https://app.example.com
APP_URL=https://app.example.com

# MySQL (required). Prefer managed DB with TLS: DB_SSL=true
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=picklecoach_app
DB_PASSWORD=replace-with-strong-password
DB_NAME=picklecoach
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=10

# Auth (required, min 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Stripe LIVE only in production (sk_live_… / whsec_… for the live endpoint)
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_CONNECT_RETURN_URL=https://app.example.com/coach/onboarding/return
STRIPE_CONNECT_REFRESH_URL=https://app.example.com/coach/onboarding/refresh

# Email (required for verification / booking mail in production)
SENDGRID_API_KEY=SG.replace
SENDGRID_FROM_EMAIL=noreply@example.com

# Optional SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

LOG_LEVEL=info

# Set to false on API-only replicas if workers run in a dedicated process.
# Default (unset): workers start with the API process.
# WORKERS_ENABLED=true
